 INSERT OR IGNORE INTO todo_links(id,todo_id,kind,url,target_id,title)
 SELECT id,issue_id,'TASK',NULL,linked_issue_id,NULL FROM issue_links;
 
 UPDATE todos
 SET notes=NULLIF(COALESCE(notes,'') || COALESCE((
