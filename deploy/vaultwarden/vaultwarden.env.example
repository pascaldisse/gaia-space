# /etc/vaultwarden/vaultwarden.env  (root:vaultwarden 640)
DOMAIN=https://paloptic.com/space/vault
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8095
DATA_FOLDER=/var/lib/vaultwarden
WEB_VAULT_ENABLED=false
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
# Generate: openssl rand -base64 48
# Keep the PLAIN value also in /root/.vaultwarden-admin-token (600, root-only) --
# server-to-server admin calls need the plain token (see INSTALL.md step 2).
ADMIN_TOKEN=changeme-openssl-rand-base64-48
LOG_LEVEL=info
