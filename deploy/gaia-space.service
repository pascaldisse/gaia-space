[Unit]
Description=GAIA Space web API
After=network.target

[Service]
Type=simple
User=gaia-space
Group=gaia-space
EnvironmentFile=/etc/gaia-space.env
# Quest owns this store. Space gets a read-only group grant solely to render
# admin-gated contact leads; browser clients never read this path themselves.
Environment=SPACE_LEADS_PATH=/var/lib/paloptic-quest/leads.json
WorkingDirectory=/var/lib/gaia-space
ExecStart=/opt/gaia-space/bin/space-server
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
SupplementaryGroups=paloptic
ReadWritePaths=/var/lib/gaia-space
ReadOnlyPaths=/var/lib/paloptic-quest/leads.json

[Install]
WantedBy=multi-user.target
