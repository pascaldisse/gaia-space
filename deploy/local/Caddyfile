{
	admin off
	auto_https off
}
:8091 {
	bind 127.0.0.1
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /space/api/* {
		uri strip_prefix /space
		reverse_proxy 127.0.0.1:8090
	}
	handle /space/* {
		uri strip_prefix /space
		root * /Users/pascaldisse/.gaia/space/www
		try_files {path} /index.html
		file_server
	}
	handle {
		root * /Users/pascaldisse/.gaia/space/www
		try_files {path} /index.html
		file_server
	}
}
