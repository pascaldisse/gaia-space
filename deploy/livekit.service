[Unit]
Description=LiveKit media server (pinned v1.10.0)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/livekit/livekit.env
ExecStart=/opt/livekit/livekit-server --config /etc/livekit/livekit.yaml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/livekit

[Install]
WantedBy=multi-user.target
