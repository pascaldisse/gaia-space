[Unit]
Description=LiveKit media server (pinned v1.10.0)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/livekit/livekit.env
RuntimeDirectory=livekit
RuntimeDirectoryMode=0755
# LiveKit does not expand ${VAR} in YAML itself; render the secret-only config
# into systemd's private runtime directory before the daemon starts.
ExecStart=/bin/sh -ec '/usr/bin/envsubst < /etc/livekit/livekit.yaml > /run/livekit/livekit.yaml; exec /opt/livekit/livekit-server --config /run/livekit/livekit.yaml'
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/livekit

[Install]
WantedBy=multi-user.target
