redir /space /space/ 308
# Smart-HTTP must reach Space before the SPA catch-all.
handle /space/git/* {
	uri strip_prefix /space
	reverse_proxy 127.0.0.1:8090
}
handle /space/api/* {
	uri strip_prefix /space
	reverse_proxy 127.0.0.1:8090
}
# These protected routes must precede the SPA catch-all.
handle /space/hooks/* {
	uri strip_prefix /space
	reverse_proxy 127.0.0.1:8093
}
# Browser LiveKit WebSockets stay proxied, not static.
handle /space/livekit/* {
	uri strip_prefix /space/livekit
	reverse_proxy 127.0.0.1:7880
}
# Vaultwarden mounts its own routes under DOMAIN path (/space/vault) itself
# (rocket basepath = CONFIG.domain_path(), see src/main.rs launch_rocket) --
# forward the FULL path unchanged, do NOT strip the prefix.
handle /space/vault/* {
	reverse_proxy 127.0.0.1:8095
}
handle_path /space/* {
	root * /var/www/gaia-space
	try_files {path} /index.html
	file_server
}
